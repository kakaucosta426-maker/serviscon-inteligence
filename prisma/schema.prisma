generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MARKETING
  COMMERCIAL
  OPERATIONS
  MANAGER
}

enum Permission {
  DASHBOARD_READ
  USERS_MANAGE
  SETTINGS_MANAGE
  REPORTS_READ
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
  CONVERTED
}

enum ActivityType {
  TASK
  CALL
  MEETING
  MESSAGE
  VISIT
  FOLLOW_UP
}

enum ActivityStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELED
}

model Organization {
  id              String           @id @default(uuid())
  name            String
  slug            String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  users           User[]
  companies       Company[]
  contacts        Contact[]
  leads           Lead[]
  opportunities   Opportunity[]
  activities      Activity[]
  technicalVisits TechnicalVisit[]
  pipelineStages  PipelineStage[]
  sessions        Session[]
  auditLogs       AuditLog[]
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String       @unique
  passwordHash   String
  role           UserRole
  permissions    Permission[] @default([])
  isActive       Boolean      @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  ownedCompanies     Company[]        @relation("CompanyOwner")
  ownedContacts      Contact[]        @relation("ContactOwner")
  ownedLeads         Lead[]           @relation("LeadOwner")
  ownedOpportunities Opportunity[]    @relation("OpportunityOwner")
  assignedActivities Activity[]       @relation("ActivityAssignee")
  assignedVisits     TechnicalVisit[] @relation("TechnicalVisitAssignee")
  sessions           Session[]
  auditLogs          AuditLog[]       @relation("AuditLogActor")

  @@index([organizationId, role])
}

model Company {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  ownerId        String?
  owner          User?        @relation("CompanyOwner", fields: [ownerId], references: [id])
  name           String
  legalName      String?
  document       String?
  segment        String?
  city           String?
  source         String?
  notes          String?
  tags           String[]     @default([])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  contacts        Contact[]
  leads           Lead[]
  opportunities   Opportunity[]
  technicalVisits TechnicalVisit[]

  @@unique([organizationId, document])
  @@index([organizationId, name])
}

model Contact {
  id                   String       @id @default(uuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id])
  companyId            String?
  company              Company?     @relation(fields: [companyId], references: [id])
  ownerId              String?
  owner                User?        @relation("ContactOwner", fields: [ownerId], references: [id])
  name                 String
  email                String?
  phone                String?
  role                 String?
  city                 String?
  source               String?
  consentToCommunicate Boolean      @default(false)
  notes                String?
  tags                 String[]     @default([])
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  deletedAt            DateTime?

  leads         Lead[]
  opportunities Opportunity[]
  activities    Activity[]

  @@unique([organizationId, email])
  @@index([organizationId, name])
}

model Lead {
  id                   String       @id @default(uuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id])
  companyId            String?
  company              Company?     @relation(fields: [companyId], references: [id])
  contactId            String?
  contact              Contact?     @relation(fields: [contactId], references: [id])
  ownerId              String?
  owner                User?        @relation("LeadOwner", fields: [ownerId], references: [id])
  source               String
  serviceInterest      String
  segment              String?
  city                 String?
  companySize          String?
  urgency              String?
  status               LeadStatus   @default(NEW)
  consentToCommunicate Boolean      @default(false)
  enteredAt            DateTime     @default(now())
  notes                String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  deletedAt            DateTime?
}

model PipelineStage {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  position       Int
  isWon          Boolean      @default(false)
  isLost         Boolean      @default(false)

  opportunities Opportunity[]

  @@unique([organizationId, position])
}

model Opportunity {
  id                String        @id @default(uuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id])
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id])
  contactId         String?
  contact           Contact?      @relation(fields: [contactId], references: [id])
  stageId           String
  stage             PipelineStage @relation(fields: [stageId], references: [id])
  ownerId           String?
  owner             User?         @relation("OpportunityOwner", fields: [ownerId], references: [id])
  serviceInterest   String
  segment           String?
  estimatedValue    Decimal?
  probability       Int           @default(0)
  source            String?
  expectedCloseDate DateTime?
  nextActivityAt    DateTime?
  notes             String?
  lossReason        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  activities      Activity[]
  technicalVisits TechnicalVisit[]

  @@index([organizationId, stageId])
}

model Activity {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  assigneeId     String?
  assignee       User?          @relation("ActivityAssignee", fields: [assigneeId], references: [id])
  opportunityId  String?
  opportunity    Opportunity?   @relation(fields: [opportunityId], references: [id])
  contactId      String?
  contact        Contact?       @relation(fields: [contactId], references: [id])
  type           ActivityType
  title          String
  description    String?
  dueAt          DateTime?
  priority       Int            @default(2)
  status         ActivityStatus @default(OPEN)
  reminderAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
}

model TechnicalVisit {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  companyId        String
  company          Company      @relation(fields: [companyId], references: [id])
  opportunityId    String?
  opportunity      Opportunity? @relation(fields: [opportunityId], references: [id])
  assigneeId       String?
  assignee         User?        @relation("TechnicalVisitAssignee", fields: [assigneeId], references: [id])
  address          String
  serviceEvaluated String
  scheduledAt      DateTime
  checklist        Json?
  attachments      Json?
  notes            String?
  status           String       @default("SCHEDULED")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?
}

model Session {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  tokenHash      String       @unique
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([organizationId, userId])
  @@index([expiresAt])
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  actorUserId    String?
  actor          User?        @relation("AuditLogActor", fields: [actorUserId], references: [id])
  action         String
  entityType     String
  entityId       String
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, entityType, entityId])
}
